# Database
POSTGRES_USER=mch_english
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mch_english
DATABASE_URL=postgresql+asyncpg://mch_english:changeme@postgres:5432/mch_english

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
# OBLIGATORIO: generá tu propia clave (mínimo 32 caracteres). El backend se niega a
# arrancar con un placeholder o con una clave corta -- quien conozca la clave puede
# firmar tokens válidos para cualquier cuenta.
#   openssl rand -hex 32
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Si ponés un proxy inverso (nginx, Traefik, un balanceador) delante del backend,
# listá acá su IP para que el rate limit por IP siga viendo la del cliente real.
FORWARDED_ALLOW_IPS=127.0.0.1

# Origenes permitidos por CORS, separados por coma (sin espacios) o como JSON array.
# En produccion, poné el dominio real de tu frontend en vez de localhost.
CORS_ORIGINS=http://localhost:3000

# Rate limiting en /auth/login (5/min) y /auth/register (3/hora) por IP.
# Desactivalo solo si ya tenés un limitador equivalente delante (ej. un API gateway).
RATE_LIMIT_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
